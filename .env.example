# Copy to .env and replace every `change-me` value. Never commit .env.

# Camera authentication and configuration
CAMERA_API_KEY=change-me-to-a-long-random-value
KNOWN_CAMERAS=mess_main
MAX_UPLOAD_BYTES=10485760

# Redis latest-reading cache (local Docker default shown)
REDIS_URL=redis://localhost:6379/0
LATEST_TTL_SECONDS=30
READ_CACHE_TTL_SECONDS=5

# InfluxDB 2.x / Cloud connection (local Docker values shown)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change-me-to-a-long-random-value
INFLUX_ORG=mess-monitor
INFLUX_BUCKET=camera-metrics

# Used only by Docker Compose to initialize the local InfluxDB container
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=change-me-to-a-long-random-value

# Dashboard and browser access
READ_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:8501

# Optional detector overrides. Defaults match inference/model.py.
MODEL_WEIGHTS=yolov8n.pt
MODEL_CONFIDENCE=0.25
MODEL_IOU=0.5
MODEL_IMAGE_SIZE=1280

# Reviewed person-crop classifiers. Set false only while diagnosing or retraining.
ATTRIBUTE_CLASSIFIERS_ENABLED=true
QUEUE_CLASSIFIER_WEIGHTS=queue_classifier.pt
SEATED_CLASSIFIER_WEIGHTS=seated_classifier.pt
